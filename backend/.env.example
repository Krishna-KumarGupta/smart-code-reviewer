# ============================================
# Smart Code Reviewer — Backend Environment
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server
PORT=5000

# Supabase — get these from your Supabase project settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS — frontend origin
FRONTEND_URL=http://localhost:5173

# Admin — comma-separated list of emails to auto-promote as admin
# Used as a reference; actual promotion is done via SQL UPDATE on profiles table
ADMIN_EMAILS=admin@yourdomain.com
