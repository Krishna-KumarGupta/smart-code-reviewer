# ============================================
# Smart Code Reviewer — Backend Environment
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server
PORT=5000

# Supabase — get these from your Supabase project settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# CORS — frontend origin
FRONTEND_URL=http://localhost:5173

# Admin — comma-separated list of emails to auto-promote as admin
# Used as a reference; actual promotion is done via SQL UPDATE on profiles table
ADMIN_EMAILS=admin@yourdomain.com

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create a GitHub OAuth App at: https://github.com/settings/developers
# → New OAuth App
# → Homepage URL:       http://localhost:5173
# → Authorization callback URL: http://localhost:5000/api/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/github/callback

# HMAC-SHA256 secret for signing OAuth state tokens (CSRF protection)
# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_STATE_SECRET=your-state-secret-here

# ─── Token Encryption ─────────────────────────────────────────────────────────
# AES-256-GCM key — MUST be exactly 64 hex chars (32 bytes)
# Generate a secure key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your-64-hex-char-encryption-key-here

# ─── GitHub Webhook ───────────────────────────────────────────────────────────
# Secret used to verify HMAC-SHA256 signatures on incoming GitHub webhooks.
# Both webhook-service (primary) and backend (failover) validate this independently.
#
# Webhook endpoint architecture:
#   GitHub → nginx:8080/api/github/webhook → webhook-service:5001 (primary)
#                                          ↘ backend:5000          (failover)
#
# WEBHOOK_ENDPOINT_URL — the URL registered with GitHub via the API.
# MUST point at nginx, not directly at backend or webhook-service.
#
# Development (ngrok):
#   1. ngrok http 8080
#   2. Set WEBHOOK_ENDPOINT_URL=https://<your-id>.ngrok.io/api/github/webhook
#
# Migration note for existing webhooks:
#   Repos already registered with the old backend URL continue to work
#   because backend's webhook endpoint remains fully active.
#   Only newly-enabled repos receive the nginx URL automatically.
#   To migrate an existing repo: disable and re-enable code review in the UI
#   (this triggers a new webhook creation call with the current URL).
#
# ─── Redis & Celery ───────────────────────────────────────────────────────────
# Redis connection URL (used for deduplication and task queue)
REDIS_URL=redis://localhost:6379

# Generate a secure webhook secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
WEBHOOK_ENDPOINT_URL=https://your-ngrok-id.ngrok.io/api/github/webhook

