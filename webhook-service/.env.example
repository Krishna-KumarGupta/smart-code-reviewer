# =============================================================================
# Smart Code Reviewer — Webhook Service Environment Variables
# =============================================================================
# Copy this file to .env and configure the actual credentials.

# Port the microservice runs on locally
PORT=5001

# Supabase Credentials (needed to fetch repo config and write pending reviews)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-never-share-this

# GitHub Webhook Secret (used for verifying HMAC-SHA256 headers)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Redis Connection URL (for Celery and delivery deduplication)
REDIS_URL=redis://localhost:6379

# Internal review-agent url and service API key for authenticating requests
REVIEW_AGENT_URL=http://localhost:5050
SERVICE_API_KEY=your-service-api-key-here

