FROM node:22-alpine

# Install Redis server inside the container
RUN apk add --no-cache redis

WORKDIR /app

# Copy package descriptors
COPY backend/package*.json ./backend/
COPY frontend/package*.json ./frontend/

# Install dependencies
RUN cd backend && npm install
RUN cd frontend && npm install

# Copy source code
COPY backend/ ./backend/
COPY frontend/ ./frontend/
COPY start-webapp.sh ./

# Make startup script executable and fix line endings
RUN sed -i 's/\r$//' start-webapp.sh && chmod +x start-webapp.sh

# Expose ports:
# 5000: Backend API
# 5173: Frontend Web UI
# 6379: Redis
EXPOSE 5000 5173 6379

CMD ["./start-webapp.sh"]
