# =====================================================
# Smart Code Reviewer — review-agent Environment
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server
PORT=5050

# Service-to-service auth — shared secret with backend and webhook-service.
# Must match the value backend/webhook-service use when calling this service.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_API_KEY=your-service-api-key-here

# GitHub Integration & PR Commenting
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
GITHUB_APP_TOKEN=your-github-personal-access-token
GITHUB_COMMENT_ENABLED=true
GITHUB_COMMENT_MAX_INLINE=5

# Redis / Celery Task Queue
REDIS_URL=redis://redis:6379/0

# LLM Orchestration & Impact Slicing
LLM_ORCHESTRATION=true
OPENAI_API_KEY=your-openai-api-key-here
IMPACT_SLICE_MAX_TOKENS=20000

# Database (review history and cache)
DATABASE_URL=sqlite+aiosqlite:///./review_agent.db
# Production / Staging PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Email Notifications
EMAIL_ENABLED=true
FRONTEND_REVIEW_URL_BASE=http://localhost:5173/reviews

# AWS SES (optional — leave blank to skip SES and fallback to Brevo)
AWS_SES_ACCESS_KEY=your-aws-access-key-id
AWS_SES_SECRET_KEY=your-aws-secret-access-key
AWS_SES_REGION=eu-north-1
AWS_SES_SENDER_EMAIL=noreply@yourdomain.com

# Brevo Email Fallback (baseline provider)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=smart-code-reviewer
