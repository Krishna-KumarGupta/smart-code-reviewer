# =====================================================
# Smart Code Reviewer — review-agent Environment
# =====================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Server
PORT=5050

# Service-to-service auth — shared secret with backend.
# Must match the value backend uses when calling this service.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_API_KEY=your-shared-secret-here

# GitHub
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here
GITHUB_APP_TOKEN=your-github-token-here

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# LLM — routed through OpenRouter (OpenAI-SDK-compatible)
# OPENAI_API_KEY is your *OpenRouter* API key (get one at https://openrouter.ai/keys).
# OPENROUTER_BASE_URL tells the OpenAI SDK to hit OpenRouter instead of api.openai.com.
# OPENAI_MODEL must use the OpenRouter provider-prefixed form: openai/gpt-5-mini.
#
# To switch to direct OpenAI:
#   - Use your real OpenAI key for OPENAI_API_KEY
#   - Set OPENROUTER_BASE_URL=https://api.openai.com/v1  (or remove the line)
#   - Change OPENAI_MODEL=gpt-5-mini  (no prefix)
OPENAI_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-5-mini

# Impact slicing — max tokens of source context sent to the LLM
IMPACT_SLICE_MAX_TOKENS=20000

# This service's own database (review history).
# Completely separate from the Supabase project frontend/backend use.
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/review_agent
# For local dev without Postgres: uncomment the line below instead
# DATABASE_URL=sqlite+aiosqlite:///./review_agent.db

# Scoring weights (optional — defaults are compiled into scorer.py)
# SCORE_WEIGHT_OSV_CRITICAL=15
# SCORE_WEIGHT_OSV_HIGH=10
# SCORE_WEIGHT_OSV_MEDIUM=5
# SCORE_WEIGHT_OSV_LOW=2
# SCORE_WEIGHT_LINT_ERROR=5
# SCORE_WEIGHT_LINT_WARNING=2
# SCORE_WEIGHT_CIRCULAR_DEP=8
# SCORE_WEIGHT_CIRCULAR_DEP_CAP=24
# SCORE_WEIGHT_LLM_CRITICAL=12
# SCORE_WEIGHT_LLM_HIGH=8
# SCORE_WEIGHT_LLM_MEDIUM=4
# SCORE_WEIGHT_LLM_LOW=1
# SCORE_WEIGHT_STRUCTURE=3
